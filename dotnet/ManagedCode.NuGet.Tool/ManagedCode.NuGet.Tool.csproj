<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackAsTool>true</PackAsTool>
    <PackageId>nuget-manager</PackageId>
    <ToolCommandName>nuget-manager</ToolCommandName>
    <Version>0.1.2</Version>
    <Authors>ManagedCode</Authors>
    <Description>Review and update NuGet package families in .NET workspaces.</Description>
    <Title>NuGet Manager</Title>
    <Company>ManagedCode</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/managedcode/NuGetPackageManager</PackageProjectUrl>
    <RepositoryUrl>https://github.com/managedcode/NuGetPackageManager.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>nuget;dotnet;packages;dependencies</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ManagedCode.NuGet.Core/ManagedCode.NuGet.Core.csproj" />
    <PackageReference Include="Spectre.Console" Version="0.55.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" Link="THIRD_PARTY_NOTICES.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
  </ItemGroup>
</Project>
